PORT=4173
# Required: set a private PostgreSQL connection URL; see db/README.md.
DATABASE_URL=
# Optional: use only a dedicated empty database for npm run test:postgres.
TEST_DATABASE_URL=
TWIN_ENCRYPTION_KEY=replace-with-at-least-24-random-characters
OPENAI_TEXT_MODEL=gpt-5.6-luna
# Optional planner override. Leave blank to reuse OPENAI_TEXT_MODEL.
OPENAI_PLANNER_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:4173/api/integrations/calendar/callback
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:4173/api/integrations/gmail/callback
