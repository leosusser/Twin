{
  "name": "personal-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env --watch src/server.ts",
    "dev:all": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env src/dev.ts",
    "start": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env src/server.ts",
    "worker": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env src/worker.ts",
    "check:syntax": "OPENSSL_CONF=/dev/null node --check src/server.ts && OPENSSL_CONF=/dev/null node --check src/worker.ts && OPENSSL_CONF=/dev/null node --check public/app.js",
    "typecheck": "OPENSSL_CONF=/dev/null tsc -p tsconfig.json",
    "lint": "OPENSSL_CONF=/dev/null eslint --max-warnings=0 src test public/app.js eslint.config.js",
    "lint:fix": "OPENSSL_CONF=/dev/null eslint --fix src test public/app.js eslint.config.js",
    "format": "OPENSSL_CONF=/dev/null prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.js\" \"package.json\" \".github/**/*.yml\" \"AGENTS.md\" \"PLANS.md\" \"code_review.md\" \"docs/**/*.md\" \".agents/**/*.md\"",
    "format:check": "OPENSSL_CONF=/dev/null prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.js\" \"package.json\" \".github/**/*.yml\" \"AGENTS.md\" \"PLANS.md\" \"code_review.md\" \"docs/**/*.md\" \".agents/**/*.md\"",
    "check": "npm run check:syntax && npm run typecheck && npm run lint && npm run format:check",
    "verify": "npm run check && npm test",
    "test": "OPENSSL_CONF=/dev/null node --test test/*.test.ts",
    "db:migrate": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env src/storage/migrate.ts",
    "db:import": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env src/storage/import-json.ts",
    "db:seed": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env src/storage/seed.ts",
    "calendar:prototype": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env src/storage/import-calendar-feed.ts",
    "test:postgres": "OPENSSL_CONF=/dev/null node --env-file-if-exists=.env --test test/postgres.test.ts"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
